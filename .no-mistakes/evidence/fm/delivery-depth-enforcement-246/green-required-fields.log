      }
    }
    function uncomment(s, row, out, end, size) {
      out=""
      while (length(s)) {
        if (comment) {
          end=index(s,"-->"); if (!end) return out
          s=substr(s,end+3); comment=0
        } else if (inline_size) {
          if (!match(s,/`+/)) return out s
          size=RLENGTH
          out=out substr(s,1,RSTART+size-1)
