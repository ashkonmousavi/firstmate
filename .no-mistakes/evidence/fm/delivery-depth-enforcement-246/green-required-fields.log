    function table_start(row, header, delimiter, cells, count, i, cell) {
      if (row >= NR) return 0
      header=lines[row]; delimiter=lines[row+1]
      sub(/^ ? ? ?/, "", header); sub(/^ ? ? ?/, "", delimiter)
      if (header ~ /^[[:space:]]/ || delimiter ~ /^[[:space:]]/) return 0
